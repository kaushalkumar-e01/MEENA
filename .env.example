# MEENA Environment Configuration Template
# Copy this file to .env.local for Next.js, and configure appropriately.
# NEVER commit real secret keys to Git.

# -------------------------------------------------------------
# 1. Primary Neural ML Microservice (FastAPI on localhost)
# -------------------------------------------------------------
# URL where ml-service/main.py is running
ML_SERVICE_URL=http://127.0.0.1:8000

# -------------------------------------------------------------
# 2. Supabase Authentication & PostgreSQL Database
# -------------------------------------------------------------
# Obtain from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -------------------------------------------------------------
# 3. Google Gemini API (Optional Server-Side Fallback Engine)
# -------------------------------------------------------------
# Key is strictly server-side; never exposed to browser clients
GEMINI_API_KEY=

# -------------------------------------------------------------
# 4. Razorpay Payments Integration (India UPI / Cards)
# -------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
